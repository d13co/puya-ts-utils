{
  "name": "@d13co/puya-ts-utils",
  "version": "0.1.0",
  "description": "Algorand TypeScript subroutines: creating escrow accounts, reading the transaction counter, RSA signature verification, MBR credit accounting, base32 encoding",
  "keywords": [
    "algorand",
    "algorand-typescript",
    "puya",
    "puya-ts",
    "avm",
    "smart-contracts",
    "rekey",
    "txn-counter",
    "rsa",
    "dnssec",
    "mbr",
    "inner-transactions",
    "base32"
  ],
  "license": "MIT",
  "author": "Bit D13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d13co/puya-ts-utils.git",
    "directory": "projects/puya-ts-utils"
  },
  "type": "commonjs",
  "exports": {
    "./createAccount": {
      "types": "./src/createAccount.algo.ts",
      "default": "./src/createAccount.algo.ts"
    },
    "./getTxnCounter": {
      "types": "./src/getTxnCounter.algo.ts",
      "default": "./src/getTxnCounter.algo.ts"
    },
    "./rsa": {
      "types": "./src/rsa.algo.ts",
      "default": "./src/rsa.algo.ts"
    },
    "./rsaHint": {
      "import": {
        "types": "./dist/esm/rsaHint.d.ts",
        "default": "./dist/esm/rsaHint.js"
      },
      "require": {
        "types": "./dist/cjs/rsaHint.d.ts",
        "default": "./dist/cjs/rsaHint.js"
      }
    },
    "./rsaSdk": {
      "import": {
        "types": "./dist/esm/rsaSdk.d.ts",
        "default": "./dist/esm/rsaSdk.js"
      },
      "require": {
        "types": "./dist/cjs/rsaSdk.d.ts",
        "default": "./dist/cjs/rsaSdk.js"
      }
    },
    "./mbrManager": {
      "types": "./src/mbrManager.algo.ts",
      "default": "./src/mbrManager.algo.ts"
    },
    "./mbrManagerSdk": {
      "import": {
        "types": "./dist/esm/mbrManagerSdk.d.ts",
        "default": "./dist/esm/mbrManagerSdk.js"
      },
      "require": {
        "types": "./dist/cjs/mbrManagerSdk.d.ts",
        "default": "./dist/cjs/mbrManagerSdk.js"
      }
    },
    "./base32": {
      "types": "./src/base32.algo.ts",
      "default": "./src/base32.algo.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "createAccount": [
        "./src/createAccount.algo.ts"
      ],
      "getTxnCounter": [
        "./src/getTxnCounter.algo.ts"
      ],
      "rsa": [
        "./src/rsa.algo.ts"
      ],
      "rsaHint": [
        "./dist/cjs/rsaHint.d.ts"
      ],
      "rsaSdk": [
        "./dist/cjs/rsaSdk.d.ts"
      ],
      "mbrManager": [
        "./src/mbrManager.algo.ts"
      ],
      "mbrManagerSdk": [
        "./dist/cjs/mbrManagerSdk.d.ts"
      ],
      "base32": [
        "./src/base32.algo.ts"
      ]
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "algokit compile ts smart_contracts --output-source-map --out-dir artifacts && algokit generate client smart_contracts/artifacts --output {app_spec_dir}/{contract_name}Client.ts && node scripts/generate-sdk.mjs",
    "build:sdk": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --module esnext --moduleResolution bundler --outDir dist/esm && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build:sdk",
    "deploy": "ts-node-dev --transpile-only --watch .env -r dotenv/config smart_contracts/index.ts",
    "deploy:ci": "ts-node --transpile-only -r dotenv/config smart_contracts/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run algo.spec",
    "test:e2e": "vitest run e2e.spec",
    "test:pack": "node scripts/test-pack.mjs",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0",
    "npm": ">=9.0"
  },
  "peerDependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/algorand-typescript": ">=1.3.0 <2.0.0",
    "algosdk": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@algorandfoundation/algorand-typescript": {
      "optional": true
    },
    "@algorandfoundation/algokit-utils": {
      "optional": true
    },
    "algosdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^6.0.0",
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/algorand-typescript": "^1.3.0",
    "@algorandfoundation/algorand-typescript-testing": "^1.2.0",
    "@algorandfoundation/puya-ts": "^1.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.20.4",
    "algosdk": "^3.0.0",
    "dotenv": "^16.4.7",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@algorandfoundation/algorand-typescript": "1.3.0",
      "@algorandfoundation/puya-ts": "1.3.0",
      "esbuild": "0.25.0"
    }
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
