{
  "name": "@d13co/puya-ts-utils",
  "version": "0.1.0",
  "description": "Algorand TypeScript subroutines that mint keyless accounts out of application escrows",
  "keywords": [
    "algorand",
    "algorand-typescript",
    "puya",
    "puya-ts",
    "avm",
    "smart-contracts",
    "rekey"
  ],
  "license": "MIT",
  "author": "Bit D13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d13co/puya-ts-utils.git",
    "directory": "projects/puya-ts-utils"
  },
  "type": "commonjs",
  "main": "./src/createAccount.algo.ts",
  "types": "./src/createAccount.algo.ts",
  "exports": {
    ".": {
      "types": "./src/createAccount.algo.ts",
      "default": "./src/createAccount.algo.ts"
    },
    "./createAccount": {
      "types": "./src/createAccount.algo.ts",
      "default": "./src/createAccount.algo.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "createAccount": [
        "./src/createAccount.algo.ts"
      ]
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "algokit compile ts smart_contracts --output-source-map --out-dir artifacts && algokit generate client smart_contracts/artifacts --output {app_spec_dir}/{contract_name}Client.ts",
    "deploy": "ts-node-dev --transpile-only --watch .env -r dotenv/config smart_contracts/index.ts",
    "deploy:ci": "ts-node --transpile-only -r dotenv/config smart_contracts/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run algo.spec",
    "test:e2e": "vitest run e2e.spec",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0",
    "npm": ">=9.0"
  },
  "peerDependencies": {
    "@algorandfoundation/algorand-typescript": ">=1.3.0 <2.0.0"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^6.0.0",
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/algorand-typescript": "^1.3.0",
    "@algorandfoundation/algorand-typescript-testing": "^1.2.0",
    "@algorandfoundation/puya-ts": "^1.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    "algosdk": "^3.0.0",
    "dotenv": "^16.4.7",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@algorandfoundation/algorand-typescript": "1.3.0",
      "@algorandfoundation/puya-ts": "1.3.0",
      "esbuild": "0.25.0"
    }
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
